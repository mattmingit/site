---
// src/components/Home.astro
import Name from "./ui/Name.astro";
import Navbar from "./ui/Navbar.astro";
import ProjectCard from "./ui/ProjectCard.astro";
import projects from "../utils/homepage/projectsList";
import "../styles/globals.css";
---

<div>
  <Name />
  <Navbar />
  <div class="project-container">
    {
      projects.map((p) => (
        <ProjectCard
          title={p.title}
          image={p.image}
          href={p.href}
          desc={p.description}
          year={p.year}
        />
      ))
    }
  </div>
</div>

<style>
  .project-container {
    margin-top: 50px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
</style>
