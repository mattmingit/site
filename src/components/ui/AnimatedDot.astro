---
// src/componenents/ui/AnimatedDot.astro
---

<span class="animated-dot"></span>

<style>
  .animated-dot {
    display: inline-block;
    height: 8px;
    width: 8px;
    border-radius: 50%;
    background-color: #4ad969;
    margin-left: 4px;
    margin-top: 2px;
    animation: pulse 1.5s infinite;
  }

  @keyframes pulse {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.3);
    }
    100% {
      transform: scale(1);
    }
  }
</style>
