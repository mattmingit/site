---
// scr/components/ui/Name.astro
import "../../styles/globals.css";
const name = "Matteo Montanari";
const github = "github.com/mattmingit";
---

<h1 class="name-transition">
  <span class="sr-only">{name}</span>
  <span aria-hidden="true" class="transition-container hover-group">
    <span class="transition-element primary">
      {
        name.split("").map((letter, idx) => (
          <span class="letter" style={`transition-delay: ${idx * 25}ms;`}>
            {letter === " " ? "\u00A0" : letter}
          </span>
        ))
      }
    </span>
    <span class="transition-element secondary">
      {
        github.split("").map((letter, idx) => (
          <span class="letter" style={`transition-delay: ${idx * 25}ms;`}>
            <a
              href="https://github.com/mattmingit"
              rel="noopener noreferrer"
              target="_blank"
              class="github-link"
            >
              {letter}
            </a>
          </span>
        ))
      }
    </span>
  </span>
</h1>

<style>
  .name-transition {
    font-weight: 600;
    font-size: 18px;
    margin: 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .transition-container {
    display: block;
    overflow: hidden;
    position: relative;
  }

  .transition-element {
    display: inline-block;
    transition: all 0.3s ease-in-out;
    white-space: nowrap;
  }

  .hover-group:hover .transition-element.primary {
    transform: translateY(-100%);
  }

  .transition-element.secondary {
    position: absolute;
    left: 0;
    top: 0;
    transform: translateY(100%);
    transition: all 0.3s ease-in-out;
  }

  .hover-group:hover .transition-element.secondary {
    transform: translateY(0);
  }

  .hover-group:hover {
    cursor: pointer;
  }

  .github-link {
    text-decoration: none !important;
    color: var(--main-text-color);
  }

  .letter {
    display: inline-block;
  }
</style>
