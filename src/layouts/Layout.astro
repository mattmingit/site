---
// src/layout/Layout.astro
import Footer from "../components/ui/Footer.astro";
import "../styles/globals.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.ico" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.15.2/dist/katex.min.css"
    />
    <meta name="generator" content={Astro.generator} />
    <title>Matteo Montanari</title>
  </head>
  <body>
    <div class="layout-container">
      <div class="content-wrapper">
        <div class="main-content">
          <div class="content">
            <slot />
          </div>
          <div class="footer-container">
            <Footer />
          </div>
        </div>
        <div class="spacer"></div>
      </div>
    </div>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    color: #333;
  }

  .layout-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    width: auto;
  }

  .content-wrapper .main-content {
    overflow: visible;
  }

  .content-wrapper {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: center;
    gap: 80px;
    height: auto;
    padding-top: 80px;
    flex-wrap: nowrap;
    width: 100%;
    max-width: 1200px;
  }

  .main-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 40px;
    height: min-content;
    overflow: hidden;
    padding: 0;
    flex: none;
    width: 100%;
    max-width: 750px;
  }

  .content {
    width: 100%;
  }

  .footer-container {
    width: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    padding-top: 100px;
  }

  .spacer {
    display: none;
    flex-direction: column;
    align-items: flex-start;
    min-width: 100px;
    min-height: 221px;
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .content-wrapper {
      flex-direction: column;
      gap: 40px;
      padding: 40px 20px;
    }

    .navbar-container {
      position: static;
      width: 100%;
    }

    .spacer {
      display: none;
    }
  }
</style>
